# Postgres
POSTGRES_USER=hub
POSTGRES_PASSWORD=hub
POSTGRES_DB=hub

# App auth (single-user)
HUB_PASSWORD=changeme
NEXTAUTH_SECRET=gerar-com-openssl-rand-base64-32

# Evolution API
EVOLUTION_API_KEY=change-me-evolution-key
EVOLUTION_INSTANCE=hub
# Seu numero com DDI+DDD, formato so digitos: 5511999999999
WHATSAPP_TO=5511999999999

# Exa API (opcional). Permite scrape de sites com Cloudflare (ex: prosettings.net) via Exa.
# Gera em https://dashboard.exa.ai/api-keys ($10 free credit). Custo ~$0.005/fetch.
EXA_API_KEY=

# Anthropic API (opcional). Sem isso o chat roda em modo stub limitado.
# Pegue em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# === Producao (docker-compose.prod.yml) ===
# Subdominio apontando pra IP do servidor (registro A)
HUB_DOMAIN=hub.seudominio.com
# Email pro Let's Encrypt (notificacoes de cert)
CADDY_EMAIL=voce@email.com
